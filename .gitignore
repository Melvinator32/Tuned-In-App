# Node / Wrangler
node_modules/
.wrangler/
dist/

# Wrangler puts local `wrangler dev` state (including the local D1 file) here
.dev.vars

# Python leftovers from the legacy local build
__pycache__/
*.pyc
build_stage/
build/

# Generated by scripts/build-profile.mjs from profiles/<name>.js
public/static/profile.js

# Personal data. The board itself lives in D1 now; these are local snapshots
# and unrelated app data, kept on disk but out of the repo. radio_station.db is
# the exception — it stays tracked as the import source CLOUDFLARE.md points at.
radio_station_*.db
crm.db
*.ics
*.tasks.json
backups/

# Generated per-build for local-first profiles (see scripts/build-profile.mjs)
public/static/api/
public/static/migrations.js

# Account-specific: deploy URLs and the personal-content markers.
personal-config.json
